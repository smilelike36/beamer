+import base64
+import hashlib
+import queue
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+from core.file_transfer import IncomingFile, MAX_CHUNK_BYTES, TransferDispatcher, TransferEndpoint, file_records, read_record, valid_name
+
+
+class IncomingFileTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.directory = Path(self.temp.name)
+
+    def test_ordered_file_is_published_after_verification(self):
+        content = b"x" * MAX_CHUNK_BYTES + b"end"
+        with IncomingFile(self.directory, "тест.txt", len(content)) as transfer:
+            transfer.write(0, content[:MAX_CHUNK_BYTES])
+            transfer.write(MAX_CHUNK_BYTES, content[MAX_CHUNK_BYTES:])
+            self.assertFalse((self.directory / "тест.txt").exists())
+            result = transfer.finish(hashlib.sha256(content).hexdigest())
+        self.assertEqual(result.read_bytes(), content)
+        self.assertEqual(list(self.directory.iterdir()), [result])
+
+    def test_existing_file_is_never_replaced(self):
+        destination = self.directory / "file.txt"
+        destination.write_bytes(b"original")
+        with self.assertRaises(FileExistsError):
+            with IncomingFile(self.directory, destination.name, 3) as transfer:
+                transfer.write(0, b"new")
+                transfer.finish(hashlib.sha256(b"new").hexdigest())
+        self.assertEqual(destination.read_bytes(), b"original")
+        self.assertEqual(list(self.directory.iterdir()), [destination])
+
+    def test_bad_checksum_and_cancel_leave_no_file(self):
+        with self.assertRaises(ValueError):
+            with IncomingFile(self.directory, "file", 3) as transfer:
+                transfer.write(0, b"abc")
+                transfer.finish("0" * 64)
+        self.assertEqual(list(self.directory.iterdir()), [])
+        with IncomingFile(self.directory, "file", 3) as transfer:
+            transfer.write(0, b"ab")
+        self.assertEqual(list(self.directory.iterdir()), [])
+
+    def test_bad_chunks_are_rejected(self):
+        with IncomingFile(self.directory, "file", 3) as transfer:
+            for offset, data in ((1, b"x"), (0, b""), (0, b"abcd"), (0, b"x" * (MAX_CHUNK_BYTES + 1))):
+                with self.subTest(offset=offset, size=len(data)), self.assertRaises(ValueError):
+                    transfer.write(offset, data)
+        self.assertEqual(list(self.directory.iterdir()), [])
+
+    def test_names_are_portable_and_cannot_escape_the_directory(self):
+        for name in ("", ".", "..", "../a", "a\\b", "C:foo", "nul.txt", "file.", "a\x00b", "\ud800"):
+            with self.subTest(name=repr(name)):
+                self.assertFalse(valid_name(name))
+        self.assertTrue(valid_name("фото 1.png"))
+
+    def test_empty_file(self):
+        with IncomingFile(self.directory, "empty", 0) as transfer:
+            path = transfer.finish(hashlib.sha256(b"").hexdigest())
+        self.assertEqual(path.read_bytes(), b"")
+
+
+class TransferRecordTests(unittest.TestCase):
+    def test_valid_records_and_bounded_chunks(self):
+        ident = "a" * 32
+        chunk = b"z" * MAX_CHUNK_BYTES
+        records = (
+            {"type": "file_offer", "data": {"id": ident, "name": "фото.png", "size": len(chunk)}},
+            {"type": "file_chunk", "data": {"id": ident, "offset": 0, "bytes": base64.b64encode(chunk).decode()}},
+            {"type": "file_finish", "data": {"id": ident, "sha256": hashlib.sha256(chunk).hexdigest()}},
+            {"type": "file_cancel", "data": {"id": ident}},
+        )
+        for record in records:
+            with self.subTest(kind=record["type"]):
+                self.assertIsNotNone(read_record(record))
+        self.assertEqual(read_record(records[1])["bytes"], chunk)
+
+    def test_untrusted_records_are_rejected(self):
+        ident = "a" * 32
+        records = (None, {}, {"type": "file_offer", "data": {"id": ident, "name": "../x", "size": 3}},
+                   {"type": "file_offer", "data": {"id": ident, "name": "x", "size": True}},
+                   {"type": "file_chunk", "data": {"id": ident, "offset": 0, "bytes": "!!!!"}},
+                   {"type": "file_chunk", "data": {"id": ident, "offset": 0, "bytes": "a" * 100000}},
+                   {"type": "file_finish", "data": {"id": ident, "sha256": "0" * 63}},
+                   {"type": "file_cancel", "data": {"id": ident, "unexpected": 1}})
+        for record in records:
+            with self.subTest(record=str(record)[:100]):
+                self.assertIsNone(read_record(record))
+
+    def test_sender_and_receiver_round_trip(self):
+        with tempfile.TemporaryDirectory() as source_dir, tempfile.TemporaryDirectory() as dest_dir:
+            source = Path(source_dir) / "документ.bin"
+            content = bytes(range(256)) * 257
+            source.write_bytes(content)
+            records = iter(file_records(source, "1" * 32))
+            offer = read_record(next(records))
+            with IncomingFile(dest_dir, offer["name"], offer["size"]) as incoming:
+                for message in records:
+                    record = read_record(message)
+                    if record["type"] == "file_chunk":
+                        incoming.write(record["offset"], record["bytes"])
+                    else:
+                        result = incoming.finish(record["sha256"])
+            self.assertEqual(result.read_bytes(), content)
+
+    def test_sender_rejects_symbolic_links(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            real = root / "real"
+            real.write_text("test")
+            link = root / "alias"
+            try:
+                link.symlink_to(real)
+            except (OSError, NotImplementedError):
+                self.skipTest("this environment cannot create symbolic links")
+            with self.assertRaises(ValueError):
+                next(file_records(link, "a" * 32))
+
