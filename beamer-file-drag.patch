+"""A small Finder-compatible shelf window for explicit user file drops."""
+from pathlib import Path
+
+import AppKit
+import objc
+from Foundation import NSURL, NSTimer
+from PyObjCTools import AppHelper
+import file_drag_mac
+from core.i18n import tr
+
+
+class ShelfDropView(AppKit.NSView):
+    def initWithFrame_owner_(self, frame, owner):
+        self = objc.super(ShelfDropView, self).initWithFrame_(frame)
+        if self is not None:
+            self.owner = owner
+            self.registerForDraggedTypes_([AppKit.NSPasteboardTypeFileURL])
+        return self
+
+    def draggingEntered_(self, sender):
+        board = sender.draggingPasteboard()
+        urls = board.readObjectsForClasses_options_([NSURL], {AppKit.NSPasteboardURLReadingFileURLsOnlyKey: True}) or []
+        return AppKit.NSDragOperationCopy if urls and all(u.isFileURL() for u in urls) else AppKit.NSDragOperationNone
+
+    def draggingUpdated_(self, sender):
+        return self.draggingEntered_(sender)
+
+    def performDragOperation_(self, sender):
+        urls = sender.draggingPasteboard().readObjectsForClasses_options_([NSURL], {AppKit.NSPasteboardURLReadingFileURLsOnlyKey: True}) or []
+        paths = [Path(str(url.path())) for url in urls if url.isFileURL()]
+        if not paths or len(paths) != len(urls) or not all(p.is_file() and not p.is_symlink() for p in paths):
+            return False
+        self.owner.send(paths)
+        return True
+
+
+class ShelfFileButton(AppKit.NSButton):
+    def mouseDown_(self, event):
+        if not self.file_path or not Path(self.file_path).is_file():
+            return
+        file_drag_mac.start_drag(self, event, self, [self.file_path])
+
+    def draggingSession_sourceOperationMaskForDraggingContext_(self, session, context):
+        return AppKit.NSDragOperationCopy
+
+    def draggingSession_endedAtPoint_operation_(self, session, point, operation):
+        pass
+
+
+class ShelfWindow(AppKit.NSObject):
+    def initWithShelf_sender_(self, shelf, sender):
+        self = objc.super(ShelfWindow, self).init()
+        if self is None:
+            return None
+        self.shelf, self.sender = shelf, sender
+        self.last_files = None
+        rect = AppKit.NSMakeRect(80, 120, 320, 240)
+        style = AppKit.NSWindowStyleMaskTitled | AppKit.NSWindowStyleMaskClosable | AppKit.NSWindowStyleMaskNonactivatingPanel
+        self.panel = AppKit.NSPanel.alloc().initWithContentRect_styleMask_backing_defer_(rect, style, AppKit.NSBackingStoreBuffered, False)
+        self.panel.setTitle_(tr("Beamer file shelf"))
+        self.panel.setFloatingPanel_(True)
+        self.panel.setLevel_(AppKit.NSFloatingWindowLevel)
+        self.view = ShelfDropView.alloc().initWithFrame_owner_(AppKit.NSMakeRect(0, 0, 320, 240), self)
+        self.panel.setContentView_(self.view)
+        self.header = AppKit.NSTextField.labelWithString_(tr("Drop files here or drag a received file out"))
+        self.header.setFrame_(AppKit.NSMakeRect(12, 205, 296, 24))
+        self.view.addSubview_(self.header)
+        self.status = AppKit.NSTextField.labelWithString_("")
+        self.status.setFrame_(AppKit.NSMakeRect(12, 12, 296, 22))
+        self.view.addSubview_(self.status)
+        self.scroll = AppKit.NSScrollView.alloc().initWithFrame_(AppKit.NSMakeRect(8, 40, 304, 160))
+        self.scroll.setHasVerticalScroller_(True)
+        self.scroll.setBorderType_(AppKit.NSBezelBorder)
+        self.list_view = ShelfDropView.alloc().initWithFrame_owner_(AppKit.NSMakeRect(0, 0, 280, 160), self)
+        self.scroll.setDocumentView_(self.list_view)
+        self.view.addSubview_(self.scroll)
+        self.rows = []
+        self.timer = NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(0.8, self, "refresh:", None, True)
+        self.refresh_(None)
+        return self
+
+    @objc.python_method
+    def show(self):
+        self.panel.orderFrontRegardless()
+
+    @objc.python_method
+    def send(self, paths):
+        self.sender(paths, lambda text: AppHelper.callAfter(self.status.setStringValue_, text))
+
+    def refresh_(self, _timer):
+        files = self.shelf.list_files()
+        if files == self.last_files:
+            return
+        had_files = self.last_files is not None and len(files) > len(self.last_files)
+        self.last_files = files
+        for row in self.rows:
+            row.removeFromSuperview()
+        self.rows = []
+        height = max(160, len(files) * 26)
+        self.list_view.setFrameSize_(AppKit.NSMakeSize(280, height))
+        for index, path in enumerate(files):
+            row = ShelfFileButton.alloc().initWithFrame_(AppKit.NSMakeRect(2, height - (index + 1) * 26, 276, 24))
+            row.file_path = str(path)
+            row.setTitle_(path.name)
+            row.setToolTip_(str(path))
+            self.list_view.addSubview_(row)
+            self.rows.append(row)
+        if had_files:
+            self.show()
