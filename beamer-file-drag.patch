+class EndpointTests(unittest.TestCase):
+    def setUp(self):
+        self.src = tempfile.TemporaryDirectory()
+        self.dst = tempfile.TemporaryDirectory()
+        self.addCleanup(self.src.cleanup)
+        self.addCleanup(self.dst.cleanup)
+        self.messages = queue.Queue()
+        self.done = []
+        self.left = TransferEndpoint(lambda m: self.enqueue("right", m), lambda *_: None, timeout=2)
+        self.right = TransferEndpoint(lambda m: self.enqueue("left", m), lambda *_: self.dst.name,
+                                      self.done.append, timeout=2)
+        self.stopping = threading.Event()
+        self.worker = threading.Thread(target=self.pump, daemon=True)
+        self.worker.start()
+        self.addCleanup(self.stop)
+
+    def enqueue(self, target, message):
+        self.messages.put((target, message))
+        return True
+
+    def pump(self):
+        while not self.stopping.is_set():
+            try:
+                target, message = self.messages.get(timeout=0.05)
+            except queue.Empty:
+                continue
+            getattr(self, target).handle(message)
+
+    def stop(self):
+        self.left.close()
+        self.right.close()
+        self.stopping.set()
+        self.worker.join(2)
+
+    def test_transfer_over_ordered_messages(self):
+        path = Path(self.src.name) / "пример.txt"
+        content = bytes(range(256)) * 513
+        path.write_bytes(content)
+        self.assertEqual(self.left.send_file(path), len(content))
+        self.assertEqual((Path(self.dst.name) / path.name).read_bytes(), content)
+        self.assertEqual(self.done, [Path(self.dst.name) / path.name])
+
+    def test_refused_offer_leaves_no_file(self):
+        self.right._accept = lambda *_: None
+        path = Path(self.src.name) / "x"
+        path.write_bytes(b"data")
+        with self.assertRaises(ConnectionError):
+            self.left.send_file(path)
+        self.assertEqual(list(Path(self.dst.name).iterdir()), [])
+
+    def test_existing_destination_is_not_overwritten(self):
+        path = Path(self.src.name) / "x"
+        path.write_bytes(b"new")
+        destination = Path(self.dst.name) / "x"
+        destination.write_bytes(b"old")
+        with self.assertRaises(ConnectionError):
+            self.left.send_file(path)
+        self.assertEqual(destination.read_bytes(), b"old")
+        self.assertEqual(list(Path(self.dst.name).iterdir()), [destination])
+
+    def test_disconnect_cleans_partial_file(self):
+        ident = "a" * 32
+        self.right.handle({"type": "file_offer", "data": {"id": ident, "name": "x", "size": 2}})
+        self.right.handle({"type": "file_chunk", "data": {"id": ident, "offset": 0, "bytes": "YQ=="}})
+        self.right.close()
+        self.assertEqual(list(Path(self.dst.name).iterdir()), [])
+
+
+class DispatcherTests(unittest.TestCase):
+    def test_local_cancellation_interrupts_a_waiting_sender(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "test.txt"
+            path.write_text("test")
+            offered, sent, errors = threading.Event(), [], []
+            def post(message):
+                sent.append(message)
+                if message["type"] == "file_offer":
+                    offered.set()
+                return True
+            endpoint = TransferEndpoint(post, lambda *_: None, timeout=5)
+            def send():
+                try:
+                    endpoint.send_file(path)
+                except Exception as exc:
+                    errors.append(exc)
+            worker = threading.Thread(target=send)
+            worker.start()
+            try:
+                self.assertTrue(offered.wait(1))
+                self.assertTrue(endpoint.cancel_outgoing())
+                worker.join(2)
+                self.assertFalse(worker.is_alive())
+                self.assertIsInstance(errors[0], ConnectionError)
+                self.assertTrue(any(message["type"] == "file_cancel" for message in sent))
+            finally:
+                endpoint.close()
+                worker.join(2)
+
+    def test_slow_storage_does_not_block_the_link_reader(self):
+        entered, release = threading.Event(), threading.Event()
+        class SlowEndpoint:
+            def handle(self, message):
+                entered.set()
+                release.wait(2)
+            def close(self):
+                pass
+        dispatcher = TransferDispatcher(SlowEndpoint(), max_pending=1)
+        message = {"type": "file_cancel", "data": {"id": "a" * 32}}
+        try:
+            self.assertTrue(dispatcher.deliver(message))
+            self.assertTrue(entered.wait(1))
+            self.assertTrue(dispatcher.deliver(message))
+            self.assertFalse(dispatcher.deliver(message))
+        finally:
+            release.set()
+            dispatcher.close()
+            self.assertTrue(dispatcher.wait_closed(2))
+
+    def test_close_cleans_partial_file(self):
+        with tempfile.TemporaryDirectory() as directory:
+            accepted = threading.Event()
+            def accept(*_):
