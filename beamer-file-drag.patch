diff --git a/core/tests/test_file_transfer_link.py b/core/tests/test_file_transfer_link.py
new file mode 100644
index 0000000..b007732
--- /dev/null
+++ b/core/tests/test_file_transfer_link.py
@@ -0,0 +1,69 @@
+"""Transfers through the real authenticated Beamer v6 link on loopback."""
+import tempfile
+import unittest
+from pathlib import Path
+
+from core.file_transfer import TransferDispatcher, TransferEndpoint
+from core.link import OutboundLink
+from core.tests.responder_harness import B, CAPS, Machine, entry, wait_for
+from core.tests.test_link import Side
+
+
+class FileTransferLinkTests(unittest.TestCase):
+    def test_transfer_over_encrypted_link(self):
+        caps = list(CAPS) + ["file_transfer"]
+        machine = Machine([entry(B, "Peer")], caps=caps).start()
+        self.addCleanup(machine.stop)
+        source_dir = tempfile.TemporaryDirectory()
+        destination_dir = tempfile.TemporaryDirectory()
+        self.addCleanup(source_dir.cleanup)
+        self.addCleanup(destination_dir.cleanup)
+        received = []
+        destination = {}
+        destination_dispatch = {}
+
+        def file_message(link, message):
+            if link not in destination:
+                destination[link] = TransferEndpoint(link.post, lambda *_: destination_dir.name,
+                                                     received.append, timeout=4)
+                destination_dispatch[link] = TransferDispatcher(destination[link])
+            destination_dispatch[link].deliver(message)
+
+        machine.responder._callbacks["file"] = file_message
+        side = Side(machine)
+        original_identity = side.identity
+        side.identity = lambda: original_identity(caps=caps)
+        sender = {}
+        connection = OutboundLink(side.peer()["token"], side.book, side.identity,
+                                  message=lambda link, message: sender["dispatcher"].deliver(message),
+                                  reconnect_seconds=30)
+        endpoint = TransferEndpoint(connection.post, lambda *_: source_dir.name, timeout=4)
+        sender["dispatcher"] = TransferDispatcher(endpoint)
+        self.addCleanup(sender["dispatcher"].close)
+        self.addCleanup(connection.stop)
+        connection.start()
+        self.assertTrue(wait_for(connection.live, 5))
+        source = Path(source_dir.name) / "проверка.txt"
+        content = bytes(range(256)) * 512
+        source.write_bytes(content)
+        self.assertEqual(endpoint.send_file(source), len(content))
+        self.assertTrue(wait_for(lambda: bool(received), 2))
+        self.assertEqual(received[0].read_bytes(), content)
+        reverse_source = Path(destination_dir.name) / "обратно.txt"
+        reverse_source.write_bytes(b"reverse transfer")
+        remote = next(iter(destination.values()))
+        self.assertEqual(remote.send_file(reverse_source), len(b"reverse transfer"))
+        self.assertEqual((Path(source_dir.name) / reverse_source.name).read_bytes(), b"reverse transfer")
+        for dispatcher in destination_dispatch.values():
+            dispatcher.close()
+            self.assertTrue(dispatcher.wait_closed(2))
+
+    def test_incapable_peer_rejects_transfer_post(self):
+        machine = Machine([entry(B, "Peer")]).start()
+        self.addCleanup(machine.stop)
+        side = Side(machine)
+        connection = side.link()
+        self.addCleanup(connection.stop)
+        connection.start()
+        self.assertTrue(wait_for(connection.live, 5))
+        self.assertFalse(connection.post({"type": "file_cancel", "data": {"id": "a" * 32}}))
