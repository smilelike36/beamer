+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+from core.drag_handoff import DragHandoff, DragLinks, read_drag, read_transfer
+from core.file_transfer import TransferDispatcher
+from core.link import OutboundLink
+from core.tests.responder_harness import B, CAPS, Machine, entry, wait_for
+from core.tests.test_link import Side
+
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.received = []
+        self.ready = threading.Event()
+        links = {}
+        self.source = DragHandoff(lambda message: links["target"].deliver(message), lambda *_: None,
+                                  timeout=2)
+        def native(paths, release):
+            self.received.append((paths, release))
+            self.ready.set()
+        self.target = DragHandoff(lambda message: links["source"].deliver(message), native,
+                                  allow_incoming=lambda: True, timeout=2)
+        links["source"] = TransferDispatcher(self.source, validator=read_transfer)
+        links["target"] = TransferDispatcher(self.target, validator=read_transfer)
+        self.links = links
+        self.addCleanup(self.close)
+
+    def close(self):
+        for dispatcher in self.links.values():
+            dispatcher.close()
+        for dispatcher in self.links.values():
+            dispatcher.wait_closed(2)
+        for _, release in self.received:
+            release()
+
+    def files(self):
+        first = Path(self.temp.name) / "первый.txt"
+        second = Path(self.temp.name) / "second.txt"
+        first.write_bytes(b"first")
+        second.write_bytes(b"second")
+        return [first, second]
+
+    def test_transfers_before_crossing_then_starts_native_drag(self):
+        paths = self.files()
+        ident = self.source.prepare(paths)
+        self.assertFalse(self.ready.is_set())
+        self.assertTrue(self.source.start_crossing(ident))
+        self.assertTrue(self.ready.wait(2))
+        received, release = self.received[0]
+        self.assertEqual([item.name for item in received], [item.name for item in paths])
+        self.assertEqual([item.read_bytes() for item in received], [b"first", b"second"])
+        release()
+        self.assertFalse(received[0].exists())
+
+    def test_declined_peer_does_not_receive_files(self):
+        self.target._allow_incoming = lambda: False
+        with self.assertRaises(ConnectionError):
+            self.source.prepare(self.files())
+        self.assertFalse(self.ready.is_set())
+
+    def test_duplicate_names_are_not_sent(self):
