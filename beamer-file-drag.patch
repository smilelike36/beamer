+
+from core.file_shelf import FileShelf, ShelfSession, unwrap
+
+
+class FileShelfTests(unittest.TestCase):
+    def test_transfer_preserves_content_and_duplicate_names(self):
+        with tempfile.TemporaryDirectory() as root:
+            root = Path(root)
+            left, right = FileShelf(root / "left"), FileShelf(root / "right")
+            sessions = {}
+            a = ShelfSession(left, lambda msg: sessions["b"].receive(msg))
+            b = ShelfSession(right, lambda msg: sessions["a"].receive(msg))
+            sessions.update(a=a, b=b)
+            self.addCleanup(a.close)
+            self.addCleanup(b.close)
+            source = root / "тест.txt"
+            source.write_text("first", encoding="utf-8")
+            a.send_file(source)
+            source.write_text("second", encoding="utf-8")
+            a.send_file(source)
+            result = right.list_files()
+            self.assertEqual(len(result), 2)
+            self.assertEqual({p.read_text(encoding="utf-8") for p in result}, {"first", "second"})
+
+    def test_incomplete_file_is_not_visible_and_is_removed(self):
+        with tempfile.TemporaryDirectory() as root:
+            shelf = FileShelf(root)
+            folder = shelf.accept("part.txt", 4)
+            (folder / "part.txt").write_bytes(b"part")
+            self.assertEqual(shelf.list_files(), [])
+            shelf.discard_pending()
+            self.assertFalse(folder.exists())
+
+    def test_shelf_accepts_names_matching_internal_marker(self):
+        with tempfile.TemporaryDirectory() as root:
+            root = Path(root)
+            source = root / ".complete"
+            source.write_text("content")
+            shelf = FileShelf(root / "shelf")
+            stored = shelf.store_copy(source)
+            self.assertEqual(shelf.list_files(), [stored])
+            self.assertEqual(stored.read_text(), "content")
+
+    def test_disconnecting_one_session_does_not_remove_another_pending_file(self):
+        with tempfile.TemporaryDirectory() as root:
+            shelf = FileShelf(root)
+            a = shelf.accept("a.txt", 1)
+            b = shelf.accept("b.txt", 1)
+            shelf.discard_pending({a})
+            self.assertFalse(a.exists())
+            self.assertTrue(b.exists())
+
+    def test_rejects_malformed_and_unrelated_records(self):
+        self.assertIsNone(unwrap({"type": "file_shelf", "data": {"type": "file_offer", "data": {"name": "../x"}}}))
+        self.assertIsNone(unwrap({"type": "file_offer", "data": {}}))
+
+
+if __name__ == "__main__":
+    unittest.main()
