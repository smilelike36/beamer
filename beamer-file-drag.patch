@@ -0,0 +1,51 @@
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from PySide6.QtCore import QMimeData, QUrl, Qt
+from PySide6.QtWidgets import QApplication
+from core.file_shelf import FileShelf
+from file_shelf_win import ShelfWindow
+
+
+class ShelfWindowTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_drop_accepts_regular_file_and_ignores_directory(self):
+        with tempfile.TemporaryDirectory() as root:
+            path = Path(root) / "test.txt"
+            path.write_text("hello")
+            send = mock.Mock()
+            window = ShelfWindow(FileShelf(Path(root) / "shelf"), send)
+            self.addCleanup(window.close)
+            self.addCleanup(window.timer.stop)
+            mime = QMimeData()
+            mime.setUrls([QUrl.fromLocalFile(str(path))])
+            event = mock.Mock()
+            event.mimeData.return_value = mime
+            window.list.dropEvent(event)
+            send.assert_called_once()
+            self.assertEqual(send.call_args.args[0], [path])
+            event.accept.assert_called_once()
+            event.reset_mock()
+            send.reset_mock()
+            mime.setUrls([QUrl.fromLocalFile(root)])
+            window.list.dropEvent(event)
+            event.ignore.assert_called_once()
+            send.assert_not_called()
+
+    def test_completed_file_becomes_a_draggable_shelf_row(self):
+        with tempfile.TemporaryDirectory() as root:
+            source = Path(root) / "данные.txt"
+            source.write_text("test", encoding="utf8")
+            shelf = FileShelf(Path(root) / "shelf")
+            window = ShelfWindow(shelf, mock.Mock())
+            self.addCleanup(window.close)
+            self.addCleanup(window.timer.stop)
+            stored = shelf.store_copy(source)
+            window.refresh()
+            self.assertEqual(window.list.count(), 1)
+            self.assertEqual(window.list.item(0).data(Qt.ItemDataRole.UserRole), str(stored))
