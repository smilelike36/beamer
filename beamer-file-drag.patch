@@ -0,0 +1,189 @@
+import threading
+import unittest
+from collections import deque
+from types import SimpleNamespace
+from unittest import mock
+
+import file_drag_mac
+import crossing
+from bridge_fakes import FakeClock, FakeQuartz
+from fake_link import bring_up
+from core.owner import Send
+from test_bridge import make_controller
+
+
+class DetectorTests(unittest.TestCase):
+    def test_stale_pasteboard_read_is_discarded_after_release(self):
+        began, continue_read = threading.Event(), threading.Event()
+        def read():
+            began.set()
+            continue_read.wait(2)
+            return ["/tmp/old"]
+        revision = mock.Mock(side_effect=[1, 2, 2])
+        detector = file_drag_mac.DragDetector(read, revision)
+        detector.arm()
+        self.assertEqual(detector.update(True), ())
+        self.assertTrue(began.wait(1))
+        detector.update(False)
