@@ -0,0 +1,92 @@
+"""Bridge a platform file-drag gesture to the staged peer handoff.
+
+The platform supplies the native drag cancellation and the input transition.
+The input transition must enqueue focus and the held mouse button before the
+handoff sends drag_start on that same ordered link.
+"""
+
+import logging
+import threading
+
+LOGGER = logging.getLogger(__name__)
+
+
+class DragCoordinator:
+    def __init__(self, handoff, button_down, cancel_source, cross, failed=lambda exc: None):
+        self._handoff = handoff
+        self._button_down = button_down
+        self._cancel_source = cancel_source
+        self._cross = cross
+        self._failed = failed
+        self._lock = threading.RLock()
+        self._generation = 0
+        self._running = False
+        self._closed = False
+
+    def begin(self, files, crossing):
+        """Start preparing files without blocking the native input callback."""
+        files = tuple(files)
+        if not files:
+            return False
+        with self._lock:
+            if self._closed or self._running or not self._button_down():
+                return False
+            self._running = True
+            generation = self._generation
+        try:
+            threading.Thread(target=self._prepare, args=(files, crossing, generation),
+                             name="Beamer-drag-handoff", daemon=True).start()
+        except RuntimeError:
+            with self._lock:
+                self._running = False
+            raise
+        return True
+
+    def _prepare(self, files, crossing, generation):
+        try:
+            ident = self._handoff.prepare(files)
+            with self._lock:
+                if self._closed or generation != self._generation or not self._button_down():
+                    self._handoff.cancel()
+                    return
+            # The platform may marshal the transition to its input thread;
+            # never hold this lock while waiting for that thread.
+            self._cancel_source()
+            if not self._cross(crossing):
+                self._handoff.cancel()
+                raise ConnectionError("could not cross during file drag")
+            with self._lock:
+                if self._closed or generation != self._generation:
+                    self._handoff.cancel()
+                    return
+            if not self._handoff.start_crossing(ident):
+                raise ConnectionError("could not start the peer drag")
+        except Exception as exc:
+            try:
+                self._handoff.cancel()
+            except Exception:
+                LOGGER.exception("Could not cancel a failed file drag")
+            with self._lock:
+                cancelled = self._closed or generation != self._generation
+            if not cancelled:
+                LOGGER.warning("File drag could not be handed over: %s", exc)
+                self._failed(exc)
+        finally:
+            with self._lock:
+                self._running = False
+
+    def button_released(self):
+        """Call when a release arrives before the peer drag has started."""
+        with self._lock:
+            self._generation += 1
+            running = self._running
+        if running:
+            self._handoff.cancel()
+
+    def close(self):
+        with self._lock:
+            self._closed = True
+            self._generation += 1
+            running = self._running
+        if running:
+            self._handoff.cancel()
diff --git a/core/drag_handoff.py b/core/drag_handoff.py
new file mode 100644
index 0000000..2585323
--- /dev/null
+++ b/core/drag_handoff.py
@@ -0,0 +1,290 @@
+"""Coordinate staged file transfers with a platform's native drag session.
+
+The transport is an authenticated Beamer link. A source transfers every file
+before permitting a crossing; the target starts its native drag only after a
+separate crossing notification. Neither class changes mouse ownership itself.
+"""
+
+import re
+import secrets
+import shutil
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+from . import file_transfer
+
+MAX_FILES = 32
+_ID = re.compile(r"[0-9a-f]{32}")
+DRAG_TYPES = frozenset({"drag_begin", "drag_ready", "drag_start", "drag_cancel", "drag_ack"})
+
+
+def read_drag(message):
+    if (not isinstance(message, dict) or getattr(message, "malformed", False)
+            or set(message) != {"type", "data"} or not isinstance(message["data"], dict)):
+        return None
+    kind, data = message["type"], message["data"]
+    ident = data.get("id")
+    if kind not in DRAG_TYPES or not isinstance(ident, str) or not _ID.fullmatch(ident):
+        return None
+    if kind == "drag_begin" and set(data) == {"id", "count"}:
+        if type(data["count"]) is int and 1 <= data["count"] <= MAX_FILES:
+            return {"type": kind, **data}
+    if kind in ("drag_ready", "drag_start", "drag_cancel") and set(data) == {"id"}:
+        return {"type": kind, **data}
+    if kind == "drag_ack" and set(data) == {"id", "stage"} and data["stage"] in ("begin", "ready"):
+        return {"type": kind, **data}
+    return None
+
+
+def read_transfer(message):
+    """Validate either a drag control record or a bounded file record."""
+    return read_drag(message) or file_transfer.read_record(message)
+
+
+class DragHandoff:
+    """One link's drag protocol; all send-side methods run off the GUI thread.
+
+    start_native(paths, release) runs on this object's dispatcher thread. It
+    must marshal onto the UI thread and invoke release only when staged files
+    are no longer needed; a target may copy them after the drag loop ends.
+    The source must invoke start_crossing only after pointer ownership changes.
+    """
+
+    def __init__(self, post, start_native, *, allow_incoming=lambda: False, timeout=30):
+        self._post, self._start_native = post, start_native
+        self._allow_incoming, self._timeout = allow_incoming, timeout
+        self._cond = threading.Condition(threading.RLock())
+        self._closed = False
+        self._outgoing = None
+        self._prepared = False
+        self._cancelled = False
+        self._ack = None
+        self._incoming = None
+        self._retained = set()
+        self._endpoint = file_transfer.TransferEndpoint(post, self._accept, self._completed, timeout)
+
+    def _send(self, kind, ident, **data):
+        if not self._post({"type": kind, "data": {"id": ident, **data}}):
+            raise ConnectionError("drag link is unavailable")
+
+    def _accept(self, name, size):
+        with self._cond:
+            state = self._incoming
+            if (state is None or state["ready"] or len(state["files"]) >= state["count"]
+                    or state["bytes"] + size > file_transfer.MAX_FILE_BYTES
+                    or name.casefold() in state["names"]):
+                return None
+            state["names"].add(name.casefold())
+            state["bytes"] += size
+            return state["directory"]
+
+    def _completed(self, path):
+        with self._cond:
+            if self._incoming is not None:
+                self._incoming["files"].append(Path(path))
+
+    def _wait(self, ident, stage):
+        deadline = time.monotonic() + self._timeout
+        with self._cond:
+            while self._ack is None and not self._closed:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("drag handoff timed out")
+                self._cond.wait(remaining)
+            ack, self._ack = self._ack, None
+            if self._closed or ack is None or ack["type"] == "drag_cancel":
+                raise ConnectionError("drag handoff cancelled")
+            if ack["id"] != ident or ack["stage"] != stage:
+                raise ValueError("unexpected drag acknowledgement")
+
+    def prepare(self, paths):
+        paths = list(paths)
+        if not 1 <= len(paths) <= MAX_FILES:
+            raise ValueError("unsupported number of files")
+        names = [Path(path).name for path in paths]
+        if (not all(file_transfer.valid_name(name) for name in names)
+                or len({name.casefold() for name in names}) != len(names)):
+            raise ValueError("unsupported or duplicate file names")
+        ident = secrets.token_hex(16)
+        with self._cond:
+            if self._closed or self._outgoing is not None:
+                raise RuntimeError("drag handoff unavailable or busy")
+            self._outgoing = ident
+            self._prepared = False
+            self._cancelled = False
+        try:
+            self._send("drag_begin", ident, count=len(paths))
+            self._wait(ident, "begin")
+            for path in paths:
+                with self._cond:
+                    if self._cancelled or self._closed:
+                        raise ConnectionError("drag handoff cancelled")
+                self._endpoint.send_file(path)
+            with self._cond:
+                if self._cancelled or self._closed:
+                    raise ConnectionError("drag handoff cancelled")
+            self._send("drag_ready", ident)
+            self._wait(ident, "ready")
+            with self._cond:
+                if self._cancelled or self._closed:
+                    raise ConnectionError("drag handoff cancelled")
+                self._prepared = True
+            return ident
+        except Exception:
+            try:
+                self._send("drag_cancel", ident)
+            except Exception:
+                pass
+            with self._cond:
+                self._outgoing = None
+                self._prepared = False
+                self._ack = None
+            raise
+
+    def start_crossing(self, ident):
+        with self._cond:
+            if self._closed or self._outgoing != ident or not self._prepared:
+                return False
+            self._outgoing = None
+            self._prepared = False
+        self._send("drag_start", ident)
+        return True
+
+    def cancel(self):
+        with self._cond:
+            ident = self._outgoing
+            if ident is None:
+                return False
+            self._cancelled = True
+            if self._prepared:
+                self._outgoing = None
+                self._prepared = False
+                self._ack = None
+            else:
+                self._ack = {"type": "drag_cancel", "id": ident}
+            self._cond.notify_all()
+        self._endpoint.cancel_outgoing()
+        try:
+            self._send("drag_cancel", ident)
+        except Exception:
+            pass
+        return True
+
+    def handle(self, message):
+        if isinstance(message, dict) and message.get("type") in file_transfer.FILE_TYPES:
+            return self._endpoint.handle(message)
+        record = read_drag(message)
+        if record is None:
+            return False
+        kind, ident = record["type"], record["id"]
+        discard, refuse = None, False
+        with self._cond:
+            if self._closed:
+                return False
+            if kind == "drag_ack" or (kind == "drag_cancel" and ident == self._outgoing):
+                if ident == self._outgoing and self._ack is None:
+                    self._ack = record
+                    self._cond.notify_all()
+                return True
+            if kind == "drag_begin":
+                if self._incoming is not None or not self._allow_incoming():
+                    self._send("drag_cancel", ident)
+                    return True
+                directory = tempfile.mkdtemp(prefix="beamer-drag-")
+                self._incoming = {"id": ident, "directory": directory, "count": record["count"],
+                                  "files": [], "names": set(), "bytes": 0, "ready": False}
+                self._send("drag_ack", ident, stage="begin")
+                return True
+            state = self._incoming
+            if state is None or state["id"] != ident:
+                return True
+            if kind == "drag_cancel":
+                self._incoming = None
+                discard = state["directory"]
+            elif kind == "drag_ready":
+                if len(state["files"]) != state["count"]:
+                    self._incoming = None
+                    discard, refuse = state["directory"], True
+                else:
+                    state["ready"] = True
+                    self._send("drag_ack", ident, stage="ready")
+            elif kind == "drag_start" and state["ready"]:
+                self._incoming = None
+                directory = state["directory"]
+                self._retained.add(directory)
+                def release():
+                    with self._cond:
+                        if directory not in self._retained:
+                            return
+                        self._retained.remove(directory)
+                    shutil.rmtree(directory, ignore_errors=True)
+                try:
+                    self._start_native(tuple(state["files"]), release)
+                except Exception:
+                    release()
+                    raise
+        if discard is not None:
+            self._endpoint.cancel_incoming()
+            shutil.rmtree(discard, ignore_errors=True)
+            if refuse:
+                self._send("drag_cancel", ident)
+        return True
+
+    def close(self):
+        self._endpoint.close()
+        with self._cond:
+            self._closed = True
+            state, self._incoming = self._incoming, None
+            self._cond.notify_all()
+        if state is not None:
+            shutil.rmtree(state["directory"], ignore_errors=True)
+
+
+class DragLinks:
+    """Attach a handoff and worker to each authenticated connection."""
+
+    def __init__(self, start_native, allow_incoming=lambda: False, limit=16):
+        self._start_native = start_native
+        self._allow_incoming = allow_incoming
+        self._limit = limit
+        self._lock = threading.Lock()
+        self._sessions = {}
+
+    def session(self, link, post=None):
+        with self._lock:
+            if link in self._sessions:
+                return self._sessions[link][0]
+            if len(self._sessions) >= self._limit:
+                raise RuntimeError("too many file transfer links")
+            session = DragHandoff(post or link.post, self._start_native, allow_incoming=self._allow_incoming)
+            dispatcher = file_transfer.TransferDispatcher(session, validator=read_transfer)
+            self._sessions[link] = (session, dispatcher)
+            return session
+
+    def receive(self, link, message):
+        if read_transfer(message) is None:
+            return False
+        with self._lock:
+            item = self._sessions.get(link)
+        if item is None:
+            if message.get("type") != "drag_begin":
+                return False
+            self.session(link)
+            with self._lock:
+                item = self._sessions.get(link)
+        return item is not None and item[1].deliver(message)
+
+    def disconnect(self, link):
+        with self._lock:
+            item = self._sessions.pop(link, None)
+        if item is not None:
+            item[1].close()
+
+    def close(self):
+        with self._lock:
+            items = list(self._sessions.values())
+            self._sessions.clear()
+        for _session, dispatcher in items:
+            dispatcher.close()
diff --git a/core/file_shelf.py b/core/file_shelf.py
new file mode 100644
index 0000000..68b9a60
--- /dev/null
+++ b/core/file_shelf.py
@@ -0,0 +1,204 @@
+"""A local file shelf and a separate, authenticated peer transfer session.
+
+Transport adapters must only deliver messages received over an authenticated
+connection that negotiated the file_shelf capability. This module does not
+provide a UI or grant access to arbitrary local files.
+"""
+
+import os
+import hashlib
+import stat
+import shutil
+import tempfile
+import threading
+from pathlib import Path
+
+from . import file_transfer
+from .i18n import tr
+
+SHELF_MESSAGE = "file_shelf"
+
+
+def unwrap(message):
+    if not isinstance(message, dict) or set(message) != {"type", "data"}:
+        return None
+    if message.get("type") != SHELF_MESSAGE or not isinstance(message.get("data"), dict):
+        return None
+    record = message["data"]
+    return record if file_transfer.read_record(record) is not None else None
+
+
+class FileShelf:
+    """Store received files in separate private directories without overwriting."""
+
+    def __init__(self, root):
+        self.root = Path(root)
+        self.root.mkdir(mode=0o700, parents=True, exist_ok=True)
+        self._lock = threading.Lock()
+        self._pending = set()
+
+    def accept(self, name, size):
+        if not file_transfer.valid_name(name) or type(size) is not int or not 0 <= size <= file_transfer.MAX_FILE_BYTES:
+            return None
+        directory = Path(tempfile.mkdtemp(prefix="incoming-", dir=self.root))
+        with self._lock:
+            self._pending.add(directory)
+        return directory
+
+    def store_copy(self, source):
+        source = Path(source)
+        flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
+        with os.fdopen(os.open(source, flags), "rb") as stream:
+            info = os.fstat(stream.fileno())
+            if not stat.S_ISREG(info.st_mode) or info.st_size > file_transfer.MAX_FILE_BYTES:
+                raise ValueError("unsupported file")
+            directory = self.accept(source.name, info.st_size)
+            if directory is None:
+                raise ValueError("unsupported file name")
+            incoming = file_transfer.IncomingFile(directory, source.name, info.st_size)
+            digest, offset = hashlib.sha256(), 0
+            try:
+                while offset < info.st_size:
+                    block = stream.read(min(file_transfer.MAX_CHUNK_BYTES, info.st_size - offset))
+                    if not block:
+                        raise OSError("source shortened")
+                    incoming.write(offset, block)
+                    digest.update(block)
+                    offset += len(block)
+                if stream.read(1):
+                    raise OSError("source changed size")
+                path = incoming.finish(digest.hexdigest())
+                self.complete(path)
+                return path
+            except Exception:
+                incoming.cancel()
+                self.discard_pending({directory})
+                raise
+
+    def complete(self, path):
+        path = Path(path)
+        with self._lock:
+            if path.parent not in self._pending:
+                raise ValueError("file is not a pending shelf transfer")
+            # Atomic marker publication: list_files ignores incomplete transfers.
+            marker = self.root / (".complete-" + path.parent.name)
+            marker.touch(exist_ok=False)
+            self._pending.remove(path.parent)
+
+    def list_files(self):
+        result = []
+        for directory in self.root.glob("incoming-*"):
+            if not directory.is_dir() or directory.is_symlink() or not (self.root / (".complete-" + directory.name)).is_file():
+                continue
+            result.extend(path for path in directory.iterdir()
+                          if path.is_file() and not path.is_symlink())
+        return sorted(result, key=lambda item: (item.name.casefold(), str(item)))
+
+    def discard_pending(self, directories=None):
+        with self._lock:
+            pending = self._pending if directories is None else self._pending.intersection(directories)
+            self._pending = self._pending.difference(pending)
+        for directory in pending:
+            shutil.rmtree(directory, ignore_errors=True)
+
+
+class ShelfSession:
+    """Transfer shelf files without sharing state with native drag sessions."""
+
+    def __init__(self, shelf, post, timeout=30):
+        self.shelf = shelf
+        self._directories = set()
+        def accept(name, size):
+            directory = shelf.accept(name, size)
+            if directory is not None:
+                self._directories.add(directory)
+            return directory
+        self._endpoint = file_transfer.TransferEndpoint(
+            lambda record: post({"type": SHELF_MESSAGE, "data": record}),
+            accept, shelf.complete, timeout=timeout)
+        self._dispatcher = file_transfer.TransferDispatcher(self._endpoint)
+
+    def send_file(self, path):
+        return self._endpoint.send_file(os.fspath(path))
+
+    def receive(self, message):
+        record = unwrap(message)
+        return record is not None and self._dispatcher.deliver(record)
+
+    def close(self):
+        self._dispatcher.close()
+        self._dispatcher.wait_closed(2)
+        self.shelf.discard_pending(self._directories)
+
+
+class ShelfLinks:
+    """Maintain a separate shelf session per authenticated Beamer link."""
+
+    def __init__(self, root):
+        self.shelf = FileShelf(root)
+        self._lock = threading.RLock()
+        self._sessions = {}
+        self._sending = set()
+        self._closed = False
+
+    def send_files(self, link, paths, notify):
+        paths = tuple(Path(path) for path in paths)
+        if not paths or not all(path.is_file() and not path.is_symlink() for path in paths):
+            notify(tr("Choose regular files."))
+            return False
+        with self._lock:
+            if self._closed:
+                notify(tr("File shelf is closed."))
+                return False
+            if link in self._sending:
+                notify(tr("Wait for the previous transfer to finish."))
+                return False
+            self._sending.add(link)
+        def run():
+            try:
+                notify(tr("Transferring files…"))
+                session = self.session(link)
+                for path in paths:
+                    stored = self.shelf.store_copy(path)
+                    session.send_file(stored)
+                notify(tr("Files transferred."))
+            except Exception:
+                notify(tr("Could not transfer files. Check the connection and try again."))
+            finally:
+                with self._lock:
+                    self._sending.discard(link)
+        try:
+            threading.Thread(target=run, name="Beamer-shelf-send", daemon=True).start()
+        except Exception:
+            with self._lock:
+                self._sending.discard(link)
+            raise
+        return True
+
+    def session(self, link, post=None):
+        with self._lock:
+            if self._closed:
+                raise RuntimeError("shelf closed")
+            if link not in self._sessions:
+                if len(self._sessions) >= 16:
+                    raise RuntimeError("too many shelf sessions")
+                self._sessions[link] = ShelfSession(self.shelf, post or link.post)
+            return self._sessions[link]
+
+    def receive(self, link, message):
+        if unwrap(message) is None:
+            return False
+        return self.session(link).receive(message)
+
+    def disconnect(self, link):
+        with self._lock:
+            session = self._sessions.pop(link, None)
+        if session:
+            session.close()
+
+    def close(self):
+        with self._lock:
+            self._closed = True
+            sessions, self._sessions = list(self._sessions.values()), {}
+        for session in sessions:
+            session.close()
