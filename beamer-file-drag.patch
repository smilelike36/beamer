+class EncryptedHandoffTests(unittest.TestCase):
+    def test_file_drag_handoff_over_the_real_link(self):
+        caps = list(CAPS) + ["file_transfer"]
+        machine = Machine([entry(B, "Peer")], caps=caps).start()
+        self.addCleanup(machine.stop)
+        targets, target_dispatchers, captured, reverse_captured = {}, {}, [], []
+        native_started = threading.Event()
+        reverse_started = threading.Event()
+        def native(paths, release):
+            captured.append((paths, release))
+            native_started.set()
+        def incoming(link, message):
+            if link not in targets:
+                targets[link] = DragHandoff(link.post, native, allow_incoming=lambda: True, timeout=5)
+                target_dispatchers[link] = TransferDispatcher(targets[link], validator=read_transfer)
+            target_dispatchers[link].deliver(message)
+        machine.responder._callbacks["file"] = incoming
+        side = Side(machine)
+        identity = side.identity
+        side.identity = lambda: identity(caps=caps)
+        holder = {}
+        connection = OutboundLink(side.peer()["token"], side.book, side.identity,
+                                  message=lambda link, message: holder["dispatcher"].deliver(message),
+                                  reconnect_seconds=30)
+        def reverse_native(paths, release):
+            reverse_captured.append((paths, release))
+            reverse_started.set()
+        source = DragHandoff(connection.post, reverse_native, allow_incoming=lambda: True, timeout=5)
+        holder["dispatcher"] = TransferDispatcher(source, validator=read_transfer)
+        connection.start()
+        try:
+            self.assertTrue(wait_for(connection.live, 5))
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / "файл.txt"
+                path.write_bytes(b"actual encrypted link")
+                ident = source.prepare([path])
+                self.assertFalse(native_started.is_set())
+                self.assertTrue(source.start_crossing(ident))
+                self.assertTrue(native_started.wait(2))
+                self.assertEqual(captured[0][0][0].read_bytes(), b"actual encrypted link")
+                captured[0][1]()
+                reverse_file = Path(directory) / "обратно.txt"
+                reverse_file.write_bytes(b"reverse encrypted drag")
+                target = next(iter(targets.values()))
+                reverse_id = target.prepare([reverse_file])
+                self.assertTrue(target.start_crossing(reverse_id))
+                self.assertTrue(reverse_started.wait(2))
+                self.assertEqual(reverse_captured[0][0][0].read_bytes(), b"reverse encrypted drag")
+                reverse_captured[0][1]()
+        finally:
+            connection.stop()
+            holder["dispatcher"].close()
+            holder["dispatcher"].wait_closed(2)
+            for dispatcher in target_dispatchers.values():
+                dispatcher.close()
+                dispatcher.wait_closed(2)
+
+
+class DragLinkTests(unittest.TestCase):
+    def test_only_a_valid_begin_creates_a_session_and_disconnect_closes_it(self):
+        class Link:
