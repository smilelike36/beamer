+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from PySide6.QtCore import QMimeData, Qt, QUrl
+from PySide6.QtWidgets import QApplication
+
+import file_drag_win
+
+
+class WindowsDragTests(unittest.TestCase):
+    def test_local_file_urls_and_unsupported_items(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "файл.txt"
+            path.write_text("test")
+            mime = QMimeData()
+            mime.setUrls([QUrl.fromLocalFile(str(path))])
+            self.assertEqual([Path(item) for item in file_drag_win.local_files(mime)], [path])
+            mime.setUrls([QUrl.fromLocalFile(str(path)), QUrl("https://example.org/file")])
+            self.assertEqual(file_drag_win.local_files(mime), [])
+            mime.setUrls([QUrl.fromLocalFile(directory)])
+            self.assertEqual(file_drag_win.local_files(mime), [])
+
+    def test_probe_does_not_consume_the_original_drag(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "file.txt"
+            path.write_text("example")
+            mime = QMimeData()
+            mime.setUrls([QUrl.fromLocalFile(str(path))])
+            event = mock.Mock()
+            event.mimeData.return_value = mime
+            target = mock.Mock()
+            file_drag_win.DragProbe.dragEnterEvent(target, event)
+            event.ignore.assert_called_once()
+            target.files_offered.emit.assert_called_once()
+            self.assertEqual([Path(item) for item in target.files_offered.emit.call_args.args[0]], [path])
+
+    def test_native_host_keeps_files_after_copy_for_async_targets(self):
+        host, release = mock.Mock(), mock.Mock()
+        paths = ("file",)
+        with mock.patch.object(file_drag_win, "button_down", return_value=True), \
+             mock.patch.object(file_drag_win, "start_drag", return_value=Qt.DropAction.CopyAction):
+            file_drag_win.NativeDragHost._start(host, paths, release)
+        release.assert_not_called()
+        host.files_retained.emit.assert_called_once_with(paths, release)
+
+    def test_start_drag_accepts_staged_path_objects(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "файл.txt"
+            path.write_text("test")
+            drag = mock.Mock()
+            with mock.patch.object(file_drag_win, "QDrag", return_value=drag):
+                file_drag_win.start_drag(mock.Mock(), [path])
+            mime = drag.setMimeData.call_args.args[0]
+            self.assertEqual(Path(mime.urls()[0].toLocalFile()), path)
+
+    def test_native_host_cleans_up_cancelled_drag(self):
+        host, release = mock.Mock(), mock.Mock()
+        with mock.patch.object(file_drag_win, "button_down", return_value=True), \
+             mock.patch.object(file_drag_win, "start_drag", return_value=Qt.DropAction.IgnoreAction):
+            file_drag_win.NativeDragHost._start(host, ("file",), release)
+        release.assert_called_once()
+
+    def test_native_host_dispatches_to_qt_thread(self):
+        app = QApplication.instance() or QApplication([])
+        host = file_drag_win.NativeDragHost()
+        release = mock.Mock()
+        with mock.patch.object(file_drag_win, "button_down", return_value=True), \
+             mock.patch.object(file_drag_win, "start_drag", return_value=Qt.DropAction.IgnoreAction) as start:
+            host.begin(("file",), release)
+            self.assertFalse(start.called)
+            app.processEvents()
+        start.assert_called_once()
+        release.assert_called_once()
