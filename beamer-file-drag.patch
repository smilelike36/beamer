+        self.target.close()
+        self.assertFalse(directory.exists())
+        self.assertFalse(self.ready.is_set())
+
+    def test_cancel_after_preparation_cleans_staging_and_allows_retry(self):
+        paths = self.files()
+        ident = self.source.prepare(paths)
+        directory = Path(self.target._incoming["directory"])
+        self.assertTrue(self.source.cancel())
+        self.assertFalse(self.source.start_crossing(ident))
+        self.assertTrue(wait_for(lambda: not directory.exists(), 2))
+        second = self.source.prepare(paths)
+        self.assertTrue(self.source.start_crossing(second))
+        self.assertTrue(self.ready.wait(2))
+
+    def test_remote_cancel_during_partial_file_closes_and_cleans_it(self):
+        ident, file_id = "a" * 32, "b" * 32
+        self.target.handle({"type": "drag_begin", "data": {"id": ident, "count": 1}})
+        directory = Path(self.target._incoming["directory"])
+        self.target.handle({"type": "file_offer", "data": {"id": file_id, "name": "part", "size": 3}})
+        self.target.handle({"type": "file_chunk", "data": {"id": file_id, "offset": 0, "bytes": "YQ=="}})
