new file mode 100644
index 0000000..14f35f6
--- /dev/null
+++ b/mac_app/file_drag_mac.py
@@ -0,0 +1,269 @@
+"""Read actual file URLs from the macOS drag pasteboard at a crossing.
+
+This does not itself start a transfer or change the source drag session.
+The caller must only invoke it for a user-initiated file drag.
+"""
+
+import os
+import threading
+import time
+
+try:
+    import AppKit
+    import Quartz
+    from Foundation import NSURL
+    from PyObjCTools import AppHelper
+except ImportError:  # Allows platform-independent unit tests.
+    AppKit = None
+    Quartz = None
+    NSURL = None
+    AppHelper = None
+
+
+def dragged_file_paths():
+    """Return local regular files from the drag pasteboard, or an empty list.
+
+    Do not fall back to the general clipboard: its files can be unrelated to
+    the gesture. Folder and promised-file handling remain separate.
+    """
+    if AppKit is None or NSURL is None:
+        return []
+    try:
+        board = AppKit.NSPasteboard.pasteboardWithName_(AppKit.NSPasteboardNameDrag)
+        urls = board.readObjectsForClasses_options_(
+            [NSURL], {AppKit.NSPasteboardURLReadingFileURLsOnlyKey: True}) or []
+        paths = []
+        for url in urls:
+            if not url.isFileURL():
+                return []
+            path = str(url.path())
+            if not os.path.isabs(path) or not os.path.isfile(path) or os.path.islink(path):
+                return []
+            paths.append(path)
+        return paths
+    except Exception:
+        return []
+
+
+def drag_pasteboard_revision():
+    """Read the drag pasteboard revision, or None if it cannot be verified."""
+    if AppKit is None:
+        return None
+    try:
+        board = AppKit.NSPasteboard.pasteboardWithName_(AppKit.NSPasteboardNameDrag)
+        return int(board.changeCount())
+    except Exception:
+        return None
+
+
+class DragDetector:
+    """Accept file URLs only after the pasteboard changes during this press."""
+
+    def __init__(self, read=dragged_file_paths, revision=drag_pasteboard_revision):
+        self._read = read
+        self._revision = revision
+        self._lock = threading.Lock()
+        self._generation = 0
+        self._baseline = None
+        self._active = False
+        self._reading = False
+        self._last_read = float("-inf")
+        self._paths = ()
+        self._paths_revision = None
+
+    def arm(self):
+        # This snapshot precedes Finder publishing the next drag. If we cannot
+        # obtain it, fail closed rather than reuse a previous drag's contents.
+        try:
+            baseline = self._revision()
+        except Exception:
+            baseline = None
+        with self._lock:
+            self._generation += 1
+            self._baseline = baseline
+            self._active = False
+            self._reading = False
+            self._last_read = float("-inf")
+            self._paths = ()
+            self._paths_revision = None
+
+    def update(self, dragging):
+        with self._lock:
+            if not dragging:
+                if self._active or self._baseline is not None:
+                    self._generation += 1
+                self._active = False
+                self._baseline = None
+                self._paths = ()
+                self._paths_revision = None
+                self._reading = False
+                return ()
+            if self._baseline is None:
+                return ()
+            if not self._active:
+                self._active = True
+            # Recheck the revision before consuming a cached selection. A new
+            # pasteboard write invalidates it, even within one button press.
+            try:
+                current = self._revision()
+            except Exception:
+                current = None
+            if current is None or current == self._baseline:
+                self._paths = ()
+                self._paths_revision = None
+                return ()
+            if self._paths_revision != current:
+                self._paths = ()
+                self._paths_revision = None
+            if not self._paths and not self._reading and time.monotonic() - self._last_read >= 0.1:
+                generation = self._generation
+                self._reading = True
+                self._last_read = time.monotonic()
+                threading.Thread(target=self._read_async, args=(generation, current),
+                                 name="Beamer-drag-pasteboard", daemon=True).start()
+            return self._paths
+
+    def _read_async(self, generation, expected_revision):
+        try:
+            paths = tuple(self._read())
+            observed_revision = self._revision()
+        except Exception:
+            paths, observed_revision = (), None
+        with self._lock:
+            if self._active and generation == self._generation:
+                if observed_revision == expected_revision:
+                    self._paths = paths
+                    self._paths_revision = expected_revision
+                self._reading = False
+
+
+def start_drag(view, mouse_down, source, paths):
+    """Start an AppKit copy drag from an NSView on the main thread.
+
+    The application supplies the actual mouse-down event and an object
+    implementing NSDraggingSource. Paths must remain valid for the duration of
+    the session. Returns AppKit's session, or None if it cannot be started.
+    """
+    if AppKit is None or NSURL is None or mouse_down is None or not paths:
+        return None
+    if not all(os.path.isabs(p) and os.path.isfile(p) and not os.path.islink(p) for p in paths):
+        raise ValueError("drag requires local files")
+    items = []
+    workspace = AppKit.NSWorkspace.sharedWorkspace()
+    point = view.convertPoint_fromView_(mouse_down.locationInWindow(), None)
+    for path in paths:
+        filename = os.fspath(path)
+        item = AppKit.NSDraggingItem.alloc().initWithPasteboardWriter_(NSURL.fileURLWithPath_(filename))
+        icon = workspace.iconForFile_(filename)
+        item.setDraggingFrame_contents_(AppKit.NSMakeRect(point.x - 16, point.y - 16, 32, 32), icon)
+        items.append(item)
+    return view.beginDraggingSessionWithItems_event_source_(items, mouse_down, source)
+
+
+if AppKit is not None:
+    class _NativeDragView(AppKit.NSView):
+        def acceptsFirstMouse_(self, event):
+            return True
+
+        def mouseDown_(self, event):
+            self.host._mouse_down(self, event)
+
+        def draggingSession_sourceOperationMaskForDraggingContext_(self, session, context):
+            return AppKit.NSDragOperationCopy
+
+        def draggingSession_endedAtPoint_operation_(self, session, point, operation):
+            self.host._ended(operation)
+
+
+class NativeDragHost:
+    """Start a Finder-compatible drag on AppKit's main thread.
+
+    An incoming peer mouse-down must already be held. A small, temporary
+    borderless panel receives a marked synthetic mouse-down, which supplies
+    the real NSEvent needed to start an AppKit drag session. Files are retained
+    after a successful drop because the destination may still be copying them.
+    """
+
+    def __init__(self):
+        self._pending = None
+        self._panel = None
+        self._view = None
+        self._generation = 0
+        self.retained = []
+
+    def begin(self, paths, release):
+        if AppHelper is None:
+            release()
+            return
+        AppHelper.callAfter(self._begin_main, tuple(paths), release)
+
+    def _begin_main(self, paths, release):
+        if self._pending is not None or Quartz is None:
+            release()
+            return
+        if not Quartz.CGEventSourceButtonState(Quartz.kCGEventSourceStateCombinedSessionState,
+                                               Quartz.kCGMouseButtonLeft):
+            release()
+            return
+        self._generation += 1
+        generation = self._generation
+        self._pending = (paths, release, False)
+        try:
+            point = AppKit.NSEvent.mouseLocation()
+            rect = AppKit.NSMakeRect(point.x - 8, point.y - 8, 16, 16)
+            style = AppKit.NSWindowStyleMaskBorderless | AppKit.NSWindowStyleMaskNonactivatingPanel
+            panel = AppKit.NSPanel.alloc().initWithContentRect_styleMask_backing_defer_(
+                rect, style, AppKit.NSBackingStoreBuffered, False)
+            panel.setLevel_(AppKit.NSStatusWindowLevel)
+            panel.setOpaque_(False)
+            panel.setBackgroundColor_(AppKit.NSColor.clearColor())
+            panel.setHasShadow_(False)
+            view = _NativeDragView.alloc().initWithFrame_(AppKit.NSMakeRect(0, 0, 16, 16))
+            view.host = self
+            panel.setContentView_(view)
+            self._panel, self._view = panel, view
+            panel.orderFrontRegardless()
+            import input_injector_mac
+            input_injector_mac.inject_mouse_button("left", True)
+            timer = threading.Timer(2.0, lambda: AppHelper.callAfter(self._expire, generation))
+            timer.daemon = True
+            timer.start()
+        except Exception:
+            self._fail()
+
+    def _mouse_down(self, view, event):
+        if self._pending is None or self._pending[2]:
+            return
+        paths, release, _ = self._pending
+        try:
+            self._pending = (paths, release, True)
+            if start_drag(view, event, view, paths) is None:
+                self._fail()
+        except Exception:
+            self._fail()
+
+    def _expire(self, generation):
+        if self._generation == generation and self._pending is not None and not self._pending[2]:
+            self._fail()
+
+    def _ended(self, operation):
+        if self._pending is None:
+            return
+        paths, release, _ = self._pending
+        self._pending = None
+        self._close_panel()
+        if operation == AppKit.NSDragOperationNone:
+            release()
+        else:
+            self.retained.append((paths, release))
+
+    def _fail(self):
+        pending, self._pending = self._pending, None
+        self._close_panel()
+        if pending is not None:
+            pending[1]()
+
+    def _close_panel(self):
+        panel, self._panel, self._view = self._panel, None, None
+        if panel is not None:
+            panel.orderOut_(None)
