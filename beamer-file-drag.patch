+                return True
+        registry = DragLinks(lambda *_: None, allow_incoming=lambda: True, limit=1)
+        link = Link()
+        self.addCleanup(registry.close)
+        self.assertFalse(registry.receive(link, {"type": "drag_start", "data": {"id": "a" * 32}}))
+        self.assertFalse(registry._sessions)
+        self.assertTrue(registry.receive(link, {"type": "drag_begin", "data": {"id": "a" * 32, "count": 1}}))
+        session, dispatcher = registry._sessions[link]
+        self.assertTrue(wait_for(lambda: session._incoming is not None, 2))
+        directory = Path(session._incoming["directory"])
+        registry.disconnect(link)
+        self.assertTrue(dispatcher.wait_closed(2))
+        self.assertFalse(directory.exists())
