+class FileDragReceiverTests(unittest.TestCase):
+    def setUp(self):
+        self.edges = []
+        self.responder = receiver.LinkResponder(None, lambda: {}, status_callback=lambda *_: None,
+                                                desktop=mock.Mock(),
+                                                file_drag_edge_callback=lambda *args: self.edges.append(args))
+        self.link = SimpleNamespace(held={("button", "left"): None}, caps={"file_transfer"},
+                                    own_caps={"file_transfer"}, closed=threading.Event(), route=1,
+                                    post=mock.Mock(return_value=True))
+        self.responder._owner = self.link
+        outcome = SimpleNamespace(action=return_edge.CROSS, edge="left", offset=0.5,
+                                  display=None, side=None, pressure=1)
+        self.model = mock.Mock(edge="right")
+        self.model.feed.return_value = outcome
+        self.peer = b"A" * 16
+        self.responder._armed = [(self.peer, self.model)]
+
+    def test_held_file_drag_is_offered_before_switch(self):
+        after = []
+        self.assertTrue(self.responder._zones_locked(self.link, {"dx": 1, "dy": 0}, after,
+                                                    geometry=([], (0, 0), {})))
+        self.link.post.assert_not_called()
+        self.responder._run(after)
+        self.assertEqual(self.edges, [(self.link, self.peer, "left", 0.5, None, None)])
+        self.assertTrue(self.responder.file_drag_cross(self.link, self.peer, "left", 0.5))
+        self.assertEqual(self.link.post.call_args.args[0]["type"], protocol.MSG_SWITCH)
+
+    def test_no_cross_after_mouse_release(self):
+        self.link.held.clear()
+        self.assertFalse(self.responder.file_drag_cross(self.link, self.peer, "left", 0.5))
+        self.link.post.assert_not_called()
