@@ -0,0 +1,120 @@
+"""Windows Qt building blocks for a native file drag.
+
+The application must arrange an OLE drop target at the crossing and initiate
+the peer drag on its GUI thread. These helpers do not change crossing behavior.
+"""
+
+import os
+import sys
+
+from PySide6.QtCore import QMimeData, QObject, Qt, QUrl, Signal, Slot
+from PySide6.QtGui import QColor, QDrag, QPainter
+from PySide6.QtWidgets import QWidget
+
+
+def local_files(mime):
+    """Local regular files offered by a Windows drag; reject unsupported items."""
+    if not mime.hasUrls():
+        return []
+    paths = []
+    for url in mime.urls():
+        if not url.isLocalFile():
+            return []
+        path = url.toLocalFile()
+        if not os.path.isabs(path) or not os.path.isfile(path) or os.path.islink(path):
+            return []
+        paths.append(path)
+    return paths
+
+
+def start_drag(widget, paths):
+    """Start a copy-only native drag from a Qt widget on the GUI thread.
+
+    The files must remain present until this function returns. The caller must
+    ensure the user is still holding the mouse button and handle cancellation.
+    """
+    if not paths or not all(os.path.isabs(path) and os.path.isfile(path) for path in paths):
+        raise ValueError("drag requires local files")
+    mime = QMimeData()
+    mime.setUrls([QUrl.fromLocalFile(os.fspath(path)) for path in paths])
+    drag = QDrag(widget)
+    drag.setMimeData(mime)
+    return drag.exec(Qt.DropAction.CopyAction)
+
+
+def button_down():
+    if sys.platform != "win32":
+        return True
+    import ctypes
+    return bool(ctypes.windll.user32.GetAsyncKeyState(1) & 0x8000)
+
+
+class DragProbe(QWidget):
+    """A short-lived OLE target the app may place at a crossing on Windows.
+
+    Emits filenames observed on entry without accepting or completing the
+    user's original drag. The app owns positioning, hiding and the decision
+    whether a particular edge movement is eligible for file transfer.
+    """
+
+    files_offered = Signal(object)
+
+    def __init__(self):
+        super().__init__(None, Qt.WindowType.Tool | Qt.WindowType.FramelessWindowHint |
+                         Qt.WindowType.WindowStaysOnTopHint)
+        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)
+        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
+        self.setAcceptDrops(True)
+
+    def dragEnterEvent(self, event):
+        paths = local_files(event.mimeData())
+        event.ignore()
+        if paths:
+            self.files_offered.emit(paths)
+
+    def paintEvent(self, event):
+        # A fully transparent layered window can be skipped by Windows hit
+        # testing. One nearly transparent pixel region still receives OLE.
+        painter = QPainter(self)
+        painter.fillRect(self.rect(), QColor(0, 0, 0, 2))
+        painter.end()
+
+    def dropEvent(self, event):
+        # This window only observes the source; never consume the drop here.
+        event.ignore()
+
+
+class NativeDragHost(QObject):
+    """Marshal an incoming file drag onto Qt's GUI thread.
+
+    The caller supplies staged files and must call this only after arranging
+    for the mouse button to be held on Windows. A cancelled drag releases its
+    staged files. A successful drop retains them: a target can copy the files
+    asynchronously after QDrag.exec returns.
+    """
+
+    _requested = Signal(object, object)
+    files_retained = Signal(object, object)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._source = QWidget(None, Qt.WindowType.Tool | Qt.WindowType.FramelessWindowHint)
+        self._requested.connect(self._start, Qt.ConnectionType.QueuedConnection)
+
+    def begin(self, paths, release):
+        self._requested.emit(tuple(paths), release)
+
+    @Slot(object, object)
+    def _start(self, paths, release):
+        if not button_down():
+            release()
+            return
+        try:
+            action = start_drag(self._source, paths)
+        except Exception:
+            release()
+            raise
+        if action == Qt.DropAction.IgnoreAction:
+            release()
+        else:
+            self.files_retained.emit(paths, release)
