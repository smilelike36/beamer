index 0000000..62cca5f
--- /dev/null
+++ b/core/file_transfer.py
@@ -0,0 +1,389 @@
+"""Bounded file-transfer primitives; not yet connected to the platform UI.
+
+The receiver stages bytes in the destination directory and publishes a verified
+file without replacing an existing entry. Callers must authenticate the peer,
+obtain the user's intent, and arrange cancellation on disconnect.
+"""
+
+import base64
+import binascii
+import hashlib
+import os
+import queue
+import re
+import secrets
+import stat
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+MAX_FILE_BYTES = 10 * 1024**3
+MAX_CHUNK_BYTES = 32 * 1024
+_RESERVED = re.compile(r"^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\..*)?$", re.I)
+_ID = re.compile(r"[0-9a-f]{32}")
+FILE_TYPES = frozenset({"file_offer", "file_chunk", "file_finish", "file_cancel", "file_ack"})
+
+
+def read_record(message):
+    """Validate a compact transfer record. Call only after peer authentication.
+
+    Returns a normalized record or None. The transport must negotiate support,
+    bound the number of active transfers, and apply authorization separately.
+    """
+    if not isinstance(message, dict) or getattr(message, "malformed", False) or set(message) != {"type", "data"}:
+        return None
+    kind, data = message["type"], message["data"]
+    if not isinstance(data, dict):
+        return None
+    ident = data.get("id")
+    if not isinstance(ident, str) or not _ID.fullmatch(ident):
+        return None
+    if kind == "file_offer" and set(data) == {"id", "name", "size"}:
+        size = data["size"]
+        if valid_name(data["name"]) and type(size) is int and 0 <= size <= MAX_FILE_BYTES:
+            return {"type": kind, "id": ident, "name": data["name"], "size": size}
+    elif kind == "file_chunk" and set(data) == {"id", "offset", "bytes"}:
+        encoded, offset = data["bytes"], data["offset"]
+        if (isinstance(encoded, str) and len(encoded) <= ((MAX_CHUNK_BYTES + 2) // 3) * 4
+                and type(offset) is int and 0 <= offset <= MAX_FILE_BYTES):
+            try:
+                chunk = base64.b64decode(encoded, validate=True)
+            except (ValueError, binascii.Error):
+                return None
+            if 0 < len(chunk) <= MAX_CHUNK_BYTES and offset + len(chunk) <= MAX_FILE_BYTES:
+                return {"type": kind, "id": ident, "offset": offset, "bytes": chunk}
+    elif kind == "file_finish" and set(data) == {"id", "sha256"}:
+        digest = data["sha256"]
+        if isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest):
+            return {"type": kind, "id": ident, "sha256": digest}
+    elif kind == "file_cancel" and set(data) == {"id"}:
+        return {"type": kind, "id": ident}
+    elif kind == "file_ack" and set(data) == {"id", "stage", "offset"}:
+        stage, offset = data["stage"], data["offset"]
+        if stage in ("offer", "chunk", "finish") and type(offset) is int and 0 <= offset <= MAX_FILE_BYTES:
+            return {"type": kind, "id": ident, "stage": stage, "offset": offset}
+    return None
+
+
+def valid_name(name):
+    """Accept a single portable filename, never a path or Windows device name."""
+    try:
+        return (isinstance(name, str) and 0 < len(name.encode("utf-8")) <= 240
+                and name not in (".", "..") and name[-1] not in " ."
+                and not _RESERVED.fullmatch(name)
+                and not any(ord(c) < 32 or c in '<>:"/\\|?*' for c in name))
+    except UnicodeEncodeError:
+        return False
+
+
+def file_records(path, ident):
+    """Yield an offer, bounded chunks and a digest for one regular file.
+
+    The caller controls delivery and cancellation and must not send chunks until
+    the peer has accepted the offer. Files changing size during a read abort.
+    """
+    if not isinstance(ident, str) or not _ID.fullmatch(ident):
+        raise ValueError("invalid transfer id")
+    name = Path(path).name
+    if not valid_name(name):
+        raise ValueError("invalid file name")
+    if os.path.islink(path):
+        raise ValueError("symbolic links are not supported")
+    # Avoid waiting forever on a FIFO or following a symlink swapped in after
+    # the first check. Windows may not expose these flags; fstat still rejects
+    # non-regular files before anything is sent.
+    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
+    with os.fdopen(os.open(path, flags), "rb") as source:
+        info = os.fstat(source.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE_BYTES:
+            raise ValueError("not a supported regular file")
+        yield {"type": "file_offer", "data": {"id": ident, "name": name, "size": info.st_size}}
+        digest = hashlib.sha256()
+        offset = 0
+        while offset < info.st_size:
+            chunk = source.read(min(MAX_CHUNK_BYTES, info.st_size - offset))
+            if not chunk:
+                raise OSError("source file became shorter")
+            digest.update(chunk)
+            yield {"type": "file_chunk", "data": {"id": ident, "offset": offset,
+                                                   "bytes": base64.b64encode(chunk).decode("ascii")}}
+            offset += len(chunk)
+        if source.read(1):
+            raise OSError("source file became longer")
+        yield {"type": "file_finish", "data": {"id": ident, "sha256": digest.hexdigest()}}
+
+
+class IncomingFile:
+    """One ordered incoming file, explicitly committed only after verification."""
+
+    def __init__(self, directory, name, size):
+        if not valid_name(name) or type(size) is not int or not 0 <= size <= MAX_FILE_BYTES:
+            raise ValueError("invalid file name or size")
+        self.directory = Path(directory)
+        self.destination = self.directory / name
+        fd, path = tempfile.mkstemp(prefix=".beamer-transfer-", dir=self.directory)
+        self._path = Path(path)
+        self._file = os.fdopen(fd, "wb")
+        self._size = size
+        self._written = 0
+        self._digest = hashlib.sha256()
+
+    def write(self, offset, data):
+        if self._file is None:
+            raise ValueError("transfer is closed")
+        if (type(offset) is not int or offset != self._written or not isinstance(data, bytes)
+                or not 0 < len(data) <= MAX_CHUNK_BYTES or self._written + len(data) > self._size):
+            raise ValueError("invalid file chunk")
+        self._file.write(data)
+        self._digest.update(data)
+        self._written += len(data)
+
+    def finish(self, digest):
+        if self._file is None:
+            raise ValueError("transfer is closed")
+        if (self._written != self._size or not isinstance(digest, str)
+                or not re.fullmatch(r"[0-9a-f]{64}", digest)
+                or self._digest.hexdigest() != digest):
+            self.cancel()
+            raise ValueError("file size or checksum mismatch")
+        try:
+            self._file.flush()
+            self._file.close()
+            self._file = None
+            # link() is atomic and fails when the destination already exists, even
+            # if another process creates it between receiving and publishing.
+            os.link(self._path, self.destination)
+        finally:
+            self.cancel()
+        return self.destination
+
+    def cancel(self):
+        if self._file is not None:
+            self._file.close()
+            self._file = None
+        try:
+            self._path.unlink()
+        except FileNotFoundError:
+            pass
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *unused):
+        self.cancel()
+
+
+class TransferEndpoint:
+    """One peer's transfer state, using an authenticated, ordered message link.
+
+    `accept` must return a destination directory only for an authorized offer;
+    None refuses it. `post` returns false if the connection cannot queue a
+    message. Acknowledging every chunk bounds buffering on both sides. The
+    application calls close on disconnect and must keep this object per link.
+    send_file blocks and belongs on a worker, not a GUI or link-reader thread.
+    """
+
+    def __init__(self, post, accept, completed=lambda path: None, timeout=30):
+        self._post = post
+        self._accept = accept
+        self._completed = completed
+        self._timeout = timeout
+        self._condition = threading.Condition(threading.RLock())
+        self._incoming = None
+        self._outgoing = None
+        self._reply = None
+        self._closed = False
+
+    @staticmethod
+    def _message(kind, ident, **data):
+        return {"type": kind, "data": {"id": ident, **data}}
+
+    def _send(self, message):
+        if not self._post(message):
+            raise ConnectionError("file transfer link is unavailable")
+
+    def _wait(self, ident, stage, offset):
+        deadline = time.monotonic() + self._timeout
+        with self._condition:
+            while self._reply is None and not self._closed:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("file transfer acknowledgement timed out")
+                self._condition.wait(remaining)
+            response, self._reply = self._reply, None
+            if self._closed or response is None or response["type"] == "file_cancel":
+                raise ConnectionError("file transfer cancelled")
+            if response["id"] != ident or response["stage"] != stage or response["offset"] != offset:
+                raise ValueError("unexpected file transfer acknowledgement")
+
+    def send_file(self, path):
+        ident = secrets.token_hex(16)
+        with self._condition:
+            if self._closed or self._outgoing is not None:
+                raise RuntimeError("file transfer unavailable or busy")
+            self._outgoing = ident
+        offset = 0
+        records = file_records(path, ident)
+        try:
+            offer = next(records)
+            self._send(offer)
+            self._wait(ident, "offer", 0)
+            for message in records:
+                if message["type"] == "file_chunk":
+                    chunk = read_record(message)
+                    offset += len(chunk["bytes"])
+                    stage = "chunk"
+                else:
+                    stage = "finish"
+                self._send(message)
+                self._wait(ident, stage, offset)
+            return offset
+        except Exception:
+            try:
+                self._post(self._message("file_cancel", ident))
+            except Exception:
+                pass
+            raise
+        finally:
+            records.close()
+            with self._condition:
+                self._outgoing = None
+                self._reply = None
+
+    def cancel_outgoing(self):
+        """Interrupt a sender waiting for its peer, e.g. on mouse release."""
+        with self._condition:
+            ident = self._outgoing
+            if ident is None:
+                return False
+            self._reply = {"type": "file_cancel", "id": ident}
+            self._condition.notify_all()
+        try:
+            self._post(self._message("file_cancel", ident))
+        except Exception:
+            pass
+        return True
+
+    def cancel_incoming(self):
+        """Close and discard a partial incoming file without closing the link."""
+        with self._condition:
+            if self._incoming is None:
+                return False
+            self._incoming[1].cancel()
+            self._incoming = None
+            return True
+
+    def handle(self, message):
+        """Handle one record. False means malformed or not a transfer record."""
+        record = read_record(message)
+        if record is None:
+            return False
+        ident, kind = record["id"], record["type"]
+        with self._condition:
+            if self._closed:
+                return True
+            if kind == "file_ack" or (kind == "file_cancel" and ident == self._outgoing):
+                if ident == self._outgoing and self._reply is None:
+                    self._reply = record
+                    self._condition.notify_all()
+                return True
+            if kind == "file_offer":
+                if self._incoming is not None:
+                    self._send(self._message("file_cancel", ident))
+                    return True
+                try:
+                    directory = self._accept(record["name"], record["size"])
+                    if directory is None:
+                        raise ValueError("file offer refused")
+                    self._incoming = (ident, IncomingFile(directory, record["name"], record["size"]))
+                    self._send(self._message("file_ack", ident, stage="offer", offset=0))
+                except Exception:
+                    if self._incoming is not None:
+                        self._incoming[1].cancel()
+                        self._incoming = None
+                    self._send(self._message("file_cancel", ident))
+                return True
+            if self._incoming is None or self._incoming[0] != ident:
+                return True
+            incoming = self._incoming[1]
+            completed_path = None
+            try:
+                if kind == "file_cancel":
+                    incoming.cancel()
+                    self._incoming = None
+                elif kind == "file_chunk":
+                    incoming.write(record["offset"], record["bytes"])
+                    self._send(self._message("file_ack", ident, stage="chunk", offset=incoming._written))
+                elif kind == "file_finish":
+                    path = incoming.finish(record["sha256"])
+                    offset = incoming._written
+                    self._incoming = None
+                    self._completed(path)
+                    self._send(self._message("file_ack", ident, stage="finish", offset=offset))
+            except Exception:
+                incoming.cancel()
+                self._incoming = None
+                self._send(self._message("file_cancel", ident))
+        return True
+
+    def close(self):
+        with self._condition:
+            self._closed = True
+            if self._incoming is not None:
+                self._incoming[1].cancel()
+                self._incoming = None
+            self._condition.notify_all()
+
+
+class TransferDispatcher:
+    """Run disk and platform callbacks away from the input link's reader.
+
+    One per authenticated link. Capacity is intentionally small: the protocol
+    waits for each acknowledgement, so a cooperative peer never needs a
+    backlog. An overflowing peer loses its transfer session, not input.
+    """
+
+    def __init__(self, endpoint, max_pending=8, validator=read_record):
+        self._endpoint = endpoint
+        self._validator = validator
+        self._queue = queue.Queue(maxsize=max_pending)
+        self._closing = threading.Event()
+        self._stopped = threading.Event()
+        self._thread = threading.Thread(target=self._run, name="Beamer-file-transfer", daemon=True)
+        self._thread.start()
+
+    def deliver(self, message):
+        if self._closing.is_set() or self._validator(message) is None:
+            return False
+        try:
+            self._queue.put_nowait(message)
+        except queue.Full:
+            self._closing.set()
+            return False
+        return True
+
+    def _run(self):
+        try:
+            while not self._closing.is_set():
+                try:
+                    message = self._queue.get(timeout=0.1)
+                except queue.Empty:
+                    continue
+                try:
+                    self._endpoint.handle(message)
+                except Exception:
+                    # A link that cannot send the response can no longer
+                    # complete this session; dispose its partial files.
+                    self._closing.set()
+        finally:
+            try:
+                self._endpoint.close()
+            finally:
+                self._stopped.set()
+
+    def close(self):
+        self._closing.set()
+
+    def wait_closed(self, timeout=None):
+        return self._stopped.wait(timeout)
