+class ShelfLinkTests(unittest.TestCase):
+    def test_shelf_files_cross_authenticated_link_in_both_directions(self):
+        from core.file_shelf import ShelfLinks
+        from core.link import OutboundLink
+        from core.tests.responder_harness import B, CAPS, Machine, entry, wait_for
+        from core.tests.test_link import Side
+        caps = list(CAPS) + ["file_shelf"]
+        machine = Machine([entry(B, "Peer")], caps=caps).start()
+        self.addCleanup(machine.stop)
+        with tempfile.TemporaryDirectory() as root:
+            source = Path(root) / "source"
+            dest = Path(root) / "dest"
+            left, right = ShelfLinks(source), ShelfLinks(dest)
+            machine.responder._callbacks["shelf"] = right.receive
+            machine.responder._callbacks["shelf_disconnected"] = right.disconnect
+            side = Side(machine)
+            identity = side.identity
+            side.identity = lambda: identity(caps=caps)
+            connection = OutboundLink(side.peer()["token"], side.book, side.identity,
+                                      message=lambda link, msg: left.receive(link, msg), reconnect_seconds=30)
+            connection.start()
+            try:
+                self.assertTrue(wait_for(connection.live, 5))
+                content = bytes(range(256)) * 512
+                file = Path(root) / "тест.bin"
