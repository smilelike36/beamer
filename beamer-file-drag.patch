+import threading
+import unittest
+
+from core.drag_coordinator import DragCoordinator
+
+
+class CoordinatorTests(unittest.TestCase):
+    def test_prepares_before_transition_and_native_drag(self):
+        events, done = [], threading.Event()
+        class Handoff:
+            def prepare(self, files):
+                events.append(("prepare", files))
+                return "id"
+            def start_crossing(self, ident):
+                events.append(("start", ident))
+                done.set()
+                return True
+            def cancel(self):
+                events.append(("cancel",))
+        coordinator = DragCoordinator(Handoff(), lambda: True, lambda: events.append(("stop",)),
+                                      lambda edge: events.append(("cross", edge)) or True)
+        self.assertTrue(coordinator.begin(["a"], "right"))
+        self.assertTrue(done.wait(1))
+        self.assertEqual(events, [("prepare", ("a",)), ("stop",), ("cross", "right"), ("start", "id")])
+
+    def test_release_before_preparation_finishes_cancels_without_crossing(self):
+        started, unblock, finished = threading.Event(), threading.Event(), threading.Event()
+        crossed = []
+        class Handoff:
+            def prepare(self, files):
+                started.set()
+                unblock.wait(2)
+                finished.set()
+                return "id"
+            def start_crossing(self, ident):
+                crossed.append("start")
+                return True
+            def cancel(self):
+                return True
+        coordinator = DragCoordinator(Handoff(), lambda: True, lambda: None,
+                                      lambda edge: crossed.append("cross") or True)
+        self.assertTrue(coordinator.begin(["a"], "right"))
+        self.assertTrue(started.wait(1))
+        coordinator.button_released()
+        unblock.set()
+        self.assertTrue(finished.wait(1))
+        self.assertEqual(crossed, [])
